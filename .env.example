# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL (remote). The connection URL is built from these values;
# the password may contain any characters, no URL-encoding needed.
DB_HOST=<host>
DB_PORT=5432
DB_NAME=refunds
DB_USER=refund_app
DB_PASSWORD=<password>
DB_SSLMODE=require
# Optional: a full URL instead of the DB_* values above (it takes precedence).
# DATABASE_URL=postgresql://refund_app:<password>@<host>:5432/refunds?sslmode=require

OPENAI_API_KEY=
LLM_MODEL=openai:gpt-5-mini
REFUND_APPROVAL_THRESHOLD=100
# Optional tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
